# API (apps/api/.env) — URL pública del backend en Railway (para webhooks de MercadoPago)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/futbol
JWT_SECRET=CHANGE_ME_128_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_128_CHAR_HEX_STRING
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3001

# MercadoPago
MP_ACCESS_TOKEN=CHANGE_ME_MERCADOPAGO_TOKEN
MP_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# WhatsApp Business Cloud API (Meta)
WHATSAPP_GRAPH_TOKEN=CHANGE_ME_WHATSAPP_GRAPH_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=CHANGE_ME_META_APP_SECRET

# Email (Resend)
EMAIL_API_KEY=CHANGE_ME_RESEND_API_KEY
EMAIL_FROM=

# Admin (apps/admin/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Mobile (apps/mobile/.env)
EXPO_PUBLIC_API_URL=https://futbol-platform-production.up.railway.app/api/v1
