# ── API (apps/api/.env) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/futbol
JWT_SECRET=CHANGE_ME_128_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_128_CHAR_HEX_STRING
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3001

# ── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=CHANGE_ME_MERCADOPAGO_TOKEN
MP_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ── WhatsApp (Evolution API) ─────────────────────────────────────────────────
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
WHATSAPP_INSTANCE=club-futbol

# ── Admin (apps/admin/.env.local) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Mobile (apps/mobile/.env)
EXPO_PUBLIC_API_URL=https://futbol-platform-production.up.railway.app/api/v1
