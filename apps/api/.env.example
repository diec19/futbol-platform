NODE_ENV=production
PORT=3001

# Railway PostgreSQL — Railway lo genera automáticamente al vincular el servicio DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_de_al_menos_32_caracteres

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del admin en Vercel (sin trailing slash). Soporta múltiples separados por coma
CORS_ORIGIN=https://tu-admin.vercel.app,http://localhost:3000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# URL pública del backend en Railway (para webhooks de MercadoPago)
APP_URL=https://tu-api.railway.app

# MercadoPago (opcional) — ahora se configura por club desde la DB
# Estos valores solo se usan como fallback si el club no tiene su propio token
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── WhatsApp (Evolution API) ─────────────────────────────────────────────────
# Requiere una instancia de Evolution API corriendo (Docker o cloud)
# Docs: https://doc.evolution-api.com
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=club-futbol
