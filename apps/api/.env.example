NODE_ENV=production
PORT=3001

# Railway PostgreSQL — copiar el valor que Railway genera automáticamente
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_de_al_menos_32_caracteres

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del admin en Vercel (sin trailing slash)
CORS_ORIGIN=https://tu-admin.vercel.app

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
