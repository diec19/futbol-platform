NODE_ENV=production
PORT=3001

# Railway PostgreSQL — Railway lo genera automáticamente al vincular el servicio DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_de_al_menos_32_caracteres

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del admin en Vercel (sin trailing slash). Soporta múltiples separados por coma
CORS_ORIGIN=https://tu-admin.vercel.app,http://localhost:3000

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# URL pública del backend en Railway (para webhooks de MercadoPago)
APP_URL=https://tu-api.railway.app

# MercadoPago (opcional) — ahora se configura por club desde la DB
# Estos valores solo se usan como fallback si el club no tiene su propio token
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta)
# Token permanente de la app de Meta + ID del número de teléfono (Phone Number ID)
WHATSAPP_GRAPH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Verify token del webhook de WhatsApp (debe coincidir con el configurado en Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta (para verificar X-Hub-Signature-256 del webhook)
WHATSAPP_APP_SECRET=

# Email (Resend) para el canal EMAIL del outbox
EMAIL_API_KEY=
EMAIL_FROM=

# 'false' desactiva crons + dispatcher outbox; por defecto arrancan
CRON_ENABLED=true
