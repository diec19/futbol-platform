generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  DELEGATE
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  FINISHED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  DOUBLE_YELLOW
  MVP
  SUBSTITUTION
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum BracketStage {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum PhaseType {
  GROUP
  KNOCKOUT
  MIXED
}

enum PaymentType {
  REGISTRATION
  MONTHLY_FEE
  FINE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum SubscriptionStatus {
  PENDING
  LINK_SENT
  PAID
  OVERDUE
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  fullName  String
  role      Role     @default(OPERATOR)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      TournamentStatus @default(DRAFT)
  logoUrl     String?
  sponsor     String?
  rules       String?
  categories  Category[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("tournaments")
}

model Category {
  id           String    @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  minAge       Int?
  maxAge       Int?
  birthYear    Int?
  maxPlayers   Int       @default(20)
  rules        String?
  phaseType    PhaseType @default(MIXED)
  active       Boolean   @default(true)
  teams        Team[]
  matches      Match[]
  groups       Group[]
  brackets     Bracket[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("categories")
}

model Team {
  id            String      @id @default(cuid())
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  shieldUrl     String?
  delegateName  String?
  contact       String?
  address       String?
  active        Boolean     @default(true)
  players       Player[]
  homeMatches   Match[]     @relation("HomeTeam")
  awayMatches   Match[]     @relation("AwayTeam")
  groupTeams    GroupTeam[]
  matchEvents   MatchEvent[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("teams")
}

model Player {
  id               String            @id @default(cuid())
  teamId           String?
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  clubCategoryId   String?
  clubCategory     ClubCategory?     @relation(fields: [clubCategoryId], references: [id], onDelete: SetNull)
  firstName        String?
  lastName         String?
  fullName         String
  isClubPlayer     Boolean           @default(false)
  dni              String            @unique
  birthDate        DateTime
  photoUrl         String?           @db.Text
  shirtNumber      Int?
  position         Position?
  dominantFoot     String?
  medicalStatus    String?
  observations     String?
  active           Boolean           @default(true)
  events           MatchEvent[]
  sanctions        Sanction[]
  credential       PlayerCredential?
  memberLinks      MemberPlayer[]
  subscriptions    PlayerSubscription[]
  joinRequests     PlayerJoinRequest[]
  unlinkRequests   UnlinkRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("players")
}

model PlayerSubscription {
  id             String             @id @default(cuid())
  playerId       String
  player         Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  amount         Float
  lateFee        Float              @default(0)
  totalAmount    Float              @default(0)
  status         SubscriptionStatus @default(PENDING)
  mpPreferenceId String?
  mpPaymentLink  String?
  mpPaymentId    String?
  paidAt         DateTime?
  dueDate        DateTime
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([playerId, month, year])
  @@map("player_subscriptions")
}

model ClubCategory {
  id          String    @id @default(cuid())
  name        String
  description String?
  birthYear   Int?
  coach       String?
  assistant   String?
  active      Boolean   @default(true)
  players     Player[]
  joinRequests PlayerJoinRequest[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("club_categories")
}

model Referee {
  id             String   @id @default(cuid())
  fullName       String
  contact        String?
  certifications String[]
  active         Boolean  @default(true)
  matches        Match[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("referees")
}

model Group {
  id         String      @id @default(cuid())
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  teams      GroupTeam[]
  matches    Match[]
  createdAt  DateTime    @default(now())

  @@unique([categoryId, name])
  @@map("groups")
}

model GroupTeam {
  id           String   @id @default(cuid())
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int      @default(0)
  won          Int      @default(0)
  drawn        Int      @default(0)
  lost         Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  goalDiff     Int      @default(0)
  points       Int      @default(0)

  @@unique([groupId, teamId])
  @@map("group_teams")
}

model Match {
  id           String       @id @default(cuid())
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  homeTeamId   String
  homeTeam     Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?
  scheduledAt  DateTime
  venue        String?
  fieldId      String?
  field        Field?       @relation(fields: [fieldId], references: [id])
  refereeId    String?
  referee      Referee?     @relation(fields: [refereeId], references: [id])
  status       MatchStatus  @default(SCHEDULED)
  round        Int?
  groupId      String?
  group        Group?       @relation(fields: [groupId], references: [id])
  bracketStage BracketStage?
  bracketId    String?
  bracket      Bracket?     @relation(fields: [bracketId], references: [id])
  notes        String?
  events       MatchEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("matches")
}

model MatchEvent {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      EventType
  playerId  String?
  player    Player?   @relation(fields: [playerId], references: [id])
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])
  minute    Int?
  notes     String?
  createdAt DateTime  @default(now())

  @@map("match_events")
}

model Bracket {
  id         String       @id @default(cuid())
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  stage      BracketStage
  matches    Match[]
  createdAt  DateTime     @default(now())

  @@unique([categoryId, stage])
  @@map("brackets")
}

model Sanction {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id])
  reason     String
  matchesBan Int
  startDate  DateTime
  endDate    DateTime?
  resolved   Boolean   @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("sanctions")
}

// ── Club Management ──────────────────────────────────────────────────────────

model Club {
  id             String        @id @default(cuid())
  name           String
  shortName      String?
  description    String?
  foundedYear    Int?
  logo           String?
  colors         String?
  address        String?
  phone          String?
  email          String?
  website        String?
  instagram      String?
  facebook       String?
  whatsapp          String?
  mpAccessToken     String?
  mpWebhookSecret String?
  monthlyPlayerFee Float?
  monthlyMemberFee Float?
  news           ClubNews[]
  gallery        ClubGallery[]
  staff          ClubStaff[]
  fields         Field[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("clubs")
}

model ClubNews {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("club_news")
}

model ClubGallery {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("club_gallery")
}

model ClubStaff {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  role      String
  photo     String?
  bio       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("club_staff")
}

model Field {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  mapUrl    String?
  capacity  Int?
  surface   String?
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fields")
}

// ── SaaS Base ────────────────────────────────────────────────────────────────

model PlayerCredential {
  id        String    @id @default(cuid())
  playerId  String    @unique
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  qrCode    String
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  @@map("player_credentials")
}

model Payment {
  id          String        @id @default(cuid())
  teamId      String
  team        Team          @relation(fields: [teamId], references: [id])
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  amount      Float
  description String?
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payments")
}

// ── Socios ───────────────────────────────────────────────────────────────────

model Member {
  id            String         @id @default(cuid())
  fullName      String
  dni           String         @unique
  email         String         @unique
  phone         String?
  address       String?
  username      String         @unique
  password      String
  active        Boolean        @default(true)
  players       MemberPlayer[]
  subscriptions Subscription[]
  notifications Notification[]
  joinRequests  PlayerJoinRequest[]
  unlinkRequests UnlinkRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("members")
}

model MemberPlayer {
  id       String @id @default(cuid())
  memberId String
  playerId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([memberId, playerId])
  @@map("member_players")
}

// Solicitud de desvinculación: el socio pide desvincular a un jugador; el admin
// aprueba (desvincula y opcionalmente marca activo/inactivo) o rechaza.
model UnlinkRequest {
  id         String                   @id @default(cuid())
  memberId   String
  member     Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reason     String?
  status     PlayerJoinRequestStatus  @default(PENDING)
  adminNote  String?
  setActive  Boolean?                 // si el admin quiere ajustar el estado del jugador al aprobar
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([status])
  @@index([memberId])
  @@map("unlink_requests")
}

enum PlayerJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Solicitud de alta de jugador self-service: el socio pide cargar a un jugador
// que no está en el plantel; el admin la aprueba/rechaza desde el panel.
model PlayerJoinRequest {
  id            String                   @id @default(cuid())
  memberId      String
  member        Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName      String
  dni           String
  birthDate     DateTime
  categoryId    String?
  category      ClubCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status        PlayerJoinRequestStatus  @default(PENDING)
  adminNote     String?
  playerId      String?
  player        Player?                  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status])
  @@index([memberId])
  @@map("player_join_requests")
}

model Subscription {
  id             String             @id @default(cuid())
  memberId       String
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  amount         Float
  status         SubscriptionStatus @default(PENDING)
  mpPreferenceId String?
  mpPaymentLink  String?
  mpPaymentId    String?
  paidAt         DateTime?
  dueDate        DateTime
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([memberId, month, year])
  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("global")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

// Notificaciones internas para el admin (requieren atencion: altas, pagos, etc.)
model AdminNotification {
  id         String   @id @default(cuid())
  type       String   // 'player_join_request' | 'payment' | ...
  refType    String?
  refId      String?
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([read, createdAt])
  @@map("admin_notifications")
}

// ── Outbox Multicanal ────────────────────────────────────────────────────────

enum OutboxChannel {
  INAPP
  WHATSAPP
  EMAIL
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationOutbox {
  id            String         @id @default(cuid())
  channel       OutboxChannel
  refType       String         // 'subscription' | 'playerSubscription' | 'sponsorshipPayment'
  entityId      String         // id de la cuota (Subscription/PlayerSubscription/SponsorshipPayment)
  recipientKey  String         // discriminador de destinatario (ej: wa:+549..., em:mail@..., members:id1,id2)
  title         String
  message       String
  payload       Json?          // { memberIds?, email?, phone?, subId, month, year, name, paymentLink? }
  status        OutboxStatus   @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  sentAt        DateTime?
  nextAttemptAt DateTime?      @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([channel, refType, entityId, recipientKey])
  @@index([status, channel, nextAttemptAt])
  @@map("notification_outbox")
}

// ── Auspiciantes ────────────────────────────────────────────────────────────

model Sponsor {
  id             String            @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  logoUrl        String?
  website        String?
  slideUrl       String?
  slideOrder     Int?
  active         Boolean           @default(true)
  plans          SponsorPlan[]
  sponsorships   Sponsorship[]
  benefits       Benefit[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("sponsors")
}

model SponsorPlan {
  id              String          @id @default(cuid())
  sponsorId       String
  sponsor         Sponsor         @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  name            String
  monthlyAmount   Float
  durationMonths  Int             @default(6)
  description     String?
  active          Boolean         @default(true)
  sponsorships    Sponsorship[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("sponsor_plans")
}

model Sponsorship {
  id              String               @id @default(cuid())
  sponsorId       String
  sponsor         Sponsor              @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  planId          String
  plan            SponsorPlan          @relation(fields: [planId], references: [id])
  startDate       DateTime
  endDate         DateTime
  status          SponsorshipStatus    @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  payments        SponsorshipPayment[]

  @@map("sponsorships")
}

model SponsorshipPayment {
  id              String             @id @default(cuid())
  sponsorshipId   String
  sponsorship     Sponsorship        @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  amount          Float
  lateFee         Float              @default(0)
  totalAmount     Float              @default(0)
  status          SubscriptionStatus @default(PENDING)
  dueDate         DateTime
  paidAt          DateTime?
  mpPreferenceId  String?
  mpPaymentLink   String?
  mpPaymentId     String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([sponsorshipId, month, year])
  @@map("sponsorship_payments")
}

// ── Beneficios ───────────────────────────────────────────────────────────────

model Benefit {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  type        String   @default("EXTERNAL")
  sponsorId   String?
  sponsor     Sponsor? @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}
