{
  "expo": {
    "name": "Fútbol Platform",
    "slug": "futbol-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "futbolplatform",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.futbolplatform.app"
    },
    "android": {
      "package": "com.futbolplatform.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-react-native-dir"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://futbol-platform-production.up.railway.app/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "97fbaca6-3562-4fc2-812d-f1f3988c868d"
      }
    },
    "owner": "dev-diegoc"
  }
}
