{
  "$schema": "https://opencode.ai/config.json",
  "username": "diegocaceres",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "references": {
    "api-docs": {
      "path": "apps/api/src",
      "description": "API source code with modules, middleware, and config"
    },
    "admin-src": {
      "path": "apps/admin/src",
      "description": "Admin dashboard source with pages, components, and lib"
    },
    "schema": {
      "path": "apps/api/prisma/schema.prisma",
      "description": "Prisma database schema with all models and enums"
    },
    "validations": {
      "path": "packages/validations/src/index.ts",
      "description": "Zod validation schemas for all API endpoints"
    }
  },
  "agent": {
    "futbol-reviewer": {
      "mode": "subagent",
      "description": "Code reviewer especializado en futbol-platform"
    },
    "futbol-tester": {
      "mode": "subagent",
      "description": "Generador de tests para el proyecto"
    },
    "futbol-docs": {
      "mode": "subagent",
      "description": "Generador de documentacion"
    },
    "futbol-devops": {
      "mode": "subagent",
      "description": "Especialista en DevOps y deployment"
    }
  },
  "permission": {
    "bash": {
      "npm *": "allow",
      "npx prisma *": "allow",
      "turbo *": "allow",
      "expo *": "allow",
      "railway *": "allow",
      "docker *": "allow",
      "*": "ask"
    }
  }
}
